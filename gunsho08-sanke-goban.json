 "poems": [
  {
   "seq": "1",
   "text": "遠近のかきねに咲るうの花はたかせこかくるゆふかとそみる",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "うの花の咲けるあすかの里にねてまたきあけぬと驚かれつゝ",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "卯花のしのゝに咲る山賤のかきねもたまのにはとなるらん",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "枝ことに玉ぬきかくるうの花を咲かはといひし人にみせはや",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "下つやみ光ともしき木のまよりもる月かけとみゆる卯花",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "雪の色をぬすみて咲るうのはなはさえてや人に疑はるらん",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "うの花のまたらの垣にいかにして道ゆく人の心とむらん",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "うの花の垣ねにとまる旅人は月に宿かるこゝちこそすれ",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "さえぬよりあやめにみれはうの花の積れる雪とみゆる也けり",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "故里はすきならねともうの花の咲る垣ねそしるし也ける",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "男鹿ふす原のゝ草の深けれはさつをのゆみちほらはよりみゆ",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "潮みてはのしまか崎のさゆり葉は波こす風の吹かぬひそなき",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "春もえしのはらの草のおひ立ちてなつは煙とみゆる也けり",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "夏のゝは過そやられぬ急けともゆくてにかゝる草むすふまに",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "かへるさの道のしるへに宮城のゝ花つまはきを乗りてそゆく",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "やきすてしふるのゝ小野の眞葛原たまゝく計也にける哉",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "あけをゝのひさきまちりの淺茅生も今はすかるのふしか也鳬",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "道しはのしけるのみかは眞葛原まくほとにみなのは也にけり",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "花のをり過かてにみし宮城のゝ萩のかつらも葉茂りあひに鳬",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "野へ〓とにいつ茂るらんさゐたつま朝ふす鹿のかくるなるまて",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "常世よりかくのこのみをうつし植て山子規ときにしそきく",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "あふ坂の山子規なのる也せきもる神や空にさゆらん",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "常になけあはてのもりの子規しのひかぬ也こゑ立てつなり",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "郭公鳴よのみかは鳴ぬ夜もまつときくとにいこそねられね",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "五月雨のあまゝを待つと我さへも旅の假いほに日數をそふる",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "五月雨はひかすへにけり東屋の軒はのかやのしたくつるまて",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "なぬかふるさ月の雨のさかなれははれまも人をわひさする哉",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "賤のやをふくまもはれぬ五月雨にもりもとまらぬすきの板葺",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "忍ひ音は今夜はかりそあけはとくまたれてきなけ山郭公",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "郭公あかぬ山ちにひかすへてよをそむくにも成ぬへき哉",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "郭公なかかそいろのくひこまれこなくといふことな〓とひそ",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "日數ふる五月雨なれは難波めのやへふくこやも漏りやしぬ覽",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "五月雨にのもみなうみと成ぬれはをさゝか原は波そ立ちける",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "五月雨は常にわたりしみな瀨川かよはぬ程になりにける哉",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "五月雨もする限ありけふはやめたみのをたにも暫しさほさん",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "いとはるゝあけのたもとに紅の淚のいとゝ色をそへつる",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "是をみよむつたのよとにさてさしてしほれしたつの麻衣かは",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "郭公まつよのかすをしらねはやふる聲をたにきかせさるらん",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "一聲のゆきかたもみむ郭公さ月のやみのなからましかは",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "五月雨はふるからをのゝ忘れ水おしひたすらの沼こえはてゝ",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "五月雨にあせのほそ道水ふかみ田なかの里は人そかよはぬ",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "あひきするたてしの蜑のふちきぬも何によりてか袖はひつ覽",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "我こひはしつのかり衣をのか身にあはぬことをも歎きつる哉",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "陸奥のしのふのれすりすり衣みなれて戀のしけりそふ哉",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "よと共にほせとほされぬ衣かな身をやく戀はきえぬものから",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
